<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>Quarkus-Langchain4j-GPULlama3-Demos</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <quarkus.version>3.33.3.1</quarkus.version>
        <quarkus-langchain4j.version>1.14.0.CR3</quarkus-langchain4j.version>
        <!-- GPULlama3 core. Pinned explicitly: the extension picks it via a JDK profile in its
             own parent, which is not reliable to inherit here. 1.0.0-jdk25 is compiled against
             tornado-api 5.0.0, so it needs TornadoVM 5.x (5.2.0-jdk25 verified) - on TornadoVM 6.x
             it fails with "Kernel entry ... has no writeReplace()". For TornadoVM 6.0.0, build the
             GPULlama3.java v1.0.0 tag against it and pin that build instead:
               mvn install -DskipTests -Dtornadovm.version=6.0.0-jdk22plus -Djdk.version.suffix=-jdk25-tvm6 -->
        <gpu-llama3.version>1.0.0-jdk25</gpu-llama3.version>
        <tornado.argfile>${env.TORNADOVM_HOME}/tornado-argfile</tornado.argfile>
    </properties>

    <modules>
        <module>demos/chat-summarization</module>
        <module>demos/streaming-summarization</module>
        <module>demos/tool-demo-ls</module>
        <module>demos/java-coder-demo</module>
        <module>demos/java-coder-iterative</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.beehive-lab</groupId>
                <artifactId>gpu-llama3</artifactId>
                <version>${gpu-llama3.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>25</source>
                        <target>25</target>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build</goal>
                                <goal>generate-code</goal>
                                <goal>generate-code-tests</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <jvmArgs>
                            @${tornado.argfile}
                            --add-modules jdk.incubator.vector
                        </jvmArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>